{
  "name": "Ednuva E2E (Playwright)",
  // Official Playwright image: Node, Chromium and all system deps for the exact @playwright/test version.
  "image": "mcr.microsoft.com/playwright:v1.56.1-noble",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": { "username": "pwuser" },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "remoteUser": "pwuser",
  "containerEnv": {
    "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright"
  },
  "postCreateCommand": "npm ci && ([ -f .env ] || cp .env.example .env)",
  "postAttachCommand": "echo '\\nEdnuva E2E ready. Run: npm test   |   Report: npm run report:serve\\n'",
  "forwardPorts": [9323],
  "portsAttributes": {
    "9323": { "label": "Playwright report", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-playwright.playwright",
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "playwright.reuseBrowser": false,
        "playwright.showTrace": true
      }
    }
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" }
}
