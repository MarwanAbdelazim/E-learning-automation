# Copy to .env to override defaults. Every value is optional.
BASE_URL=https://stage.ednuva-website-8tf.pages.dev

# Routes (relative to BASE_URL)
LOGIN_PATH=/login
SIGNUP_PATH=/register

# UI language for the default project: ar | en
LANGUAGE=ar

# Existing, verified account used by positive login tests and the authenticated session.
# Login accepts username, email or phone.
TEST_USER_LOGIN=
TEST_USER_PASSWORD=

# Sign-up verifies the mobile number by SMS OTP. Full sign-up runs only when both are set:
# a staging test number and the fixed/bypass OTP that staging accepts for it.
TEST_MOBILE=
TEST_OTP=

# Record video for every test (default: only on failure)
RECORD_VIDEO=false
HEADLESS=true
