# Copy to .env to override defaults. Every value is optional.
BASE_URL=https://stage.ednuva-website-8tf.pages.dev

# Routes (relative to BASE_URL)
LOGIN_PATH=/login
SIGNUP_PATH=/signup

# Optional pre-existing account. When unset, the auth setup project signs up a
# brand-new generated user and saves it to .auth/user.json, so no manual input is needed.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Domain used for generated sign-up emails
TEST_EMAIL_DOMAIN=mailinator.com

HEADLESS=true
